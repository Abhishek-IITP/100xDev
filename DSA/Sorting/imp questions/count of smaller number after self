class Solution {
public:
    void merge(int l, int r, vector<pair<int, int>>& nums, vector<int>& ans) {
        int mid = l + (r - l) / 2;

        int i = l;
        int j = mid + 1;

        int rightCount = 0;

        vector<pair<int, int>> temp;

        while (i <= mid && j <= r) {
            if (nums[j].first < nums[i].first) {
                rightCount++;

                temp.push_back(nums[j]);
                j++;
            } else {
                // nums[i] is bigger than all right elements
                // that have already moved
                ans[nums[i].second] += rightCount;
                temp.push_back(nums[i]);
                i++;
            }
        }
        while(i<=mid){
            ans[nums[i].second] += rightCount;

            temp.push_back(nums[i]);
            i++;
        }

        while(j<=r){
            temp.push_back(nums[j]);
            j++;
        }

        for(int k =0;k<temp.size();k++){
            nums[l+k]= temp[k];
        }
    }

    void fn(int l, int r,vector<pair<int,int>>& nums,
        vector<int>& ans ){
            if(l>=r) return;

            int mid = l+(r-l)/2;

            fn(l,mid,nums,ans);

            fn(mid+1,r,nums,ans);

            merge(l,r,nums,ans);
        }

    vector<int> countSmaller(vector<int>& nums) {

        int n = nums.size();

        vector<pair<int, int>> arr;

        for (int i = 0; i < n; i++) {
            arr.push_back({nums[i], i});
        }

        vector<int> ans(n, 0);

        fn(0, n - 1, arr, ans);

        return ans;
    }
};